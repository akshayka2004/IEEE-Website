# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact + newsletter submissions are POSTed here as JSON:
# { type: "contact" | "newsletter", name?, email, message?, submittedAt }
# Works with Formspree, a Google Apps Script web app, Zapier/Make, Slack-compatible relays, etc.
FORMS_WEBHOOK_URL=

# Social profiles — a link is shown only when its URL is set
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Optional: cookie-free analytics via Plausible (domain as registered in Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: YouTube video ID to feature on the home page (loads only after the visitor clicks play)
NEXT_PUBLIC_YOUTUBE_FEATURED_ID=

# Placeholder content (testimonials, timeline, achievements, news, newsletter archive) is shown in
# development and hidden in production unless this is "true". Replace it with real content first.
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=

# Public contact email (shown on the contact page, footer and privacy/terms). Hidden until set.
NEXT_PUBLIC_CONTACT_EMAIL=
